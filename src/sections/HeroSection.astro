---
import type { SupportedLocale } from '../i18n/utils'
import { useTranslations } from '../i18n/utils'
import FeatureCard from '../components/blocks/FeatureCard.astro'

const heroBg = '/portada2026.png'

interface Props { lang?: SupportedLocale }
const { lang = 'es' } = Astro.props
const t = useTranslations(lang)

const featureCards = [
  { icon: 'verified',             iconColor: 'secondary' as const, text: t('hero.feature.compliance'),    href: '/acreditaciones' },
  { icon: 'factory',              iconColor: 'primary'   as const, text: t('hero.feature.cost_reduction'), href: '/servicios/tarifa-plana' },
  { icon: 'recycling',            iconColor: 'secondary' as const, text: t('hero.feature.impact'),         href: '/servicios/software-trazabilidad' },
]
---

<section id="inicio" class="relative min-h-[100dvh] flex items-center pt-24 md:pt-20 pb-8 overflow-hidden">
  <!-- Imagen de fondo -->
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <img
      src={heroBg}
      alt=""
      class="w-full h-full object-cover object-center lg:object-[right_20%]"
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <div class="absolute inset-0 bg-black/50"></div>
  </div>

  <!-- Contenido -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-margin-desktop w-full">

    <!-- Acreditaciones (superior derecha) -->
    <div class="absolute top-20 lg:top-28 right-6 md:right-margin-desktop w-64 max-w-[calc(100vw-3rem)] rounded-2xl overflow-hidden bg-transparent border border-white/20">
      <ul class="divide-y divide-white/15">
        <li class="flex items-center gap-3 px-4 py-3">
          <span class="material-symbols-outlined text-white text-2xl shrink-0" aria-hidden="true">verified_user</span>
          <div class="leading-tight">
            <span class="block text-white/90 text-[10px] font-semibold uppercase tracking-wider">{t('hero.accred.operator_title')}</span>
            <span class="block text-white text-sm font-extrabold">{t('hero.accred.operator_name')}</span>
          </div>
        </li>
        <li class="flex items-center gap-3 px-4 py-3">
          <span class="material-symbols-outlined text-white text-2xl shrink-0" aria-hidden="true">eco</span>
          <div class="leading-tight">
            <span class="block text-white text-sm font-extrabold uppercase">{t('hero.accred.bic_title')}</span>
            <span class="block text-white/85 text-[11px]">{t('hero.accred.bic_desc')}</span>
          </div>
        </li>
        <li class="flex items-center gap-3 px-4 py-3">
          <span class="material-symbols-outlined text-white text-2xl shrink-0" aria-hidden="true">engineering</span>
          <span class="block text-white text-[11px] font-extrabold uppercase tracking-wide">{t('hero.accred.sanitation_title')}</span>
        </li>
      </ul>
    </div>

    <div class="max-w-2xl lg:py-20">
      <h1 class="font-headline text-[40px] md:text-[56px] lg:text-[62px] leading-[1.05] text-white mb-8 font-extrabold">
        {t('hero.title.pre')} <span class="text-secondary">{t('hero.title.highlight')}</span> {t('hero.title.post')}
      </h1>

      <p class="font-body text-lg md:text-xl text-white/80 mb-12 max-w-xl leading-relaxed">
        {t('hero.subtitle')}
      </p>

      <!-- Feature cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12" role="list" aria-label={t('hero.badge')}>
        {featureCards.map(card => (
          <div role="listitem">
            <FeatureCard {...card} />
          </div>
        ))}
      </div>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-5">
        <a
          href="#cotizacion"
          class="inline-flex items-center justify-center gap-3 bg-secondary text-white font-bold px-6 sm:px-10 py-4 rounded-full hover:bg-secondary/90 transition-all shadow-lg active:scale-95"
        >
          {t('hero.cta.primary')}
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </a>
        <a
          href="#cotizacion"
          class="inline-flex items-center justify-center gap-3 bg-white border-2 border-outline-variant/40 text-primary font-bold px-6 sm:px-10 py-4 rounded-full hover:bg-surface-container-low transition-all active:scale-95 shadow-sm"
        >
          {t('hero.cta.secondary')}
          <span class="material-symbols-outlined text-secondary" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
    </div>
  </div>
</section>