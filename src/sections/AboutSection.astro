---
import type { SupportedLocale } from '../i18n/utils'
import { useTranslations } from '../i18n/utils'
const teamImages = ['/somos1-hd.jpeg', '/somos2-hd.jpeg']
interface Props { lang?: SupportedLocale }
const { lang = 'es' } = Astro.props
const t = useTranslations(lang)
---

<section id="nosotros" class="py-section-padding bg-surface">
  <div class="max-w-7xl mx-auto px-6 md:px-margin-desktop">
    <div class="flex flex-col lg:flex-row items-center gap-16">

      <!-- Carrusel de imágenes -->
      <div class="w-full lg:w-1/2 relative overflow-hidden">
        <div
          id="about-carousel"
          class="aspect-[4/3] rounded-3xl overflow-hidden shadow-2xl relative z-10"
          role="region"
          aria-roledescription="carousel"
          aria-label={t('about.img_alt')}
        >
          {teamImages.map((src, i) => (
            <img
              src={src}
              alt={t('about.img_alt')}
              class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-in-out ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
              data-slide={i}
              loading="lazy"
              width="600"
              height="450"
            />
          ))}
          <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex items-center gap-2 z-20">
            {teamImages.map((_, i) => (
              <button
                type="button"
                data-dot={i}
                aria-label={`${t('about.img_alt')} ${i + 1}`}
                aria-current={i === 0 ? 'true' : 'false'}
                class={`h-2 rounded-full transition-all duration-300 ${i === 0 ? 'w-6 bg-white' : 'w-2 bg-white/60'}`}
              ></button>
            ))}
          </div>
        </div>
        <div class="absolute -bottom-6 -right-6 w-48 h-48 bg-secondary/10 rounded-full -z-0 blur-3xl" aria-hidden="true"></div>
      </div>

      <!-- Texto -->
      <div class="w-full lg:w-1/2">
        <span class="text-secondary font-bold text-sm uppercase tracking-widest mb-4 block">{t('section.about')}</span>
        <h2 class="font-headline text-4xl md:text-5xl text-on-surface mb-6 font-extrabold">
          {t('about.headline')}
        </h2>
        <p class="font-body text-xl md:text-2xl text-on-surface font-semibold mb-5 leading-relaxed">
          {t('about.lead')}
        </p>
        <p class="font-body text-lg text-on-surface-variant mb-4 leading-relaxed">
          {t('about.body')}
        </p>
        <p class="font-body text-lg text-on-surface-variant mb-6 leading-relaxed">
          {t('about.body_2')}
        </p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 mb-8">
          <li class="flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary text-xl shrink-0" aria-hidden="true">check_circle</span>
            <span class="text-sm font-semibold text-on-surface">{t('about.cred.minam')}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary text-xl shrink-0" aria-hidden="true">check_circle</span>
            <span class="text-sm font-semibold text-on-surface">{t('about.cred.infra')}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary text-xl shrink-0" aria-hidden="true">check_circle</span>
            <span class="text-sm font-semibold text-on-surface">{t('about.cred.bic')}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary text-xl shrink-0" aria-hidden="true">check_circle</span>
            <span class="text-sm font-semibold text-on-surface">{t('about.cred.sanitation')}</span>
          </li>
        </ul>
        <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6">
          <a
            href="/contacto"
            class="bg-primary text-white font-bold px-10 py-4 rounded-full hover:bg-primary/90 transition-all shadow-lg"
          >
            {t('btn.more')}
          </a>
          <a
            href="/nosotros"
            class="group flex items-center gap-2 text-primary font-bold hover:gap-4 transition-all"
          >
            {t('about.cta_discover')}
            <span class="material-symbols-outlined transition-transform" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  (function () {
    const carousel = document.getElementById('about-carousel')
    if (!carousel) return

    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-slide]'))
    const dots = Array.from(carousel.querySelectorAll<HTMLElement>('[data-dot]'))
    const total = slides.length
    if (total < 2) return

    let current = 0
    let timer: ReturnType<typeof setInterval> | undefined

    const stop = () => {
      if (timer) clearInterval(timer)
    }

    const show = (index: number) => {
      current = (index + total) % total
      slides.forEach((slide, i) => {
        slide.classList.toggle('opacity-100', i === current)
        slide.classList.toggle('opacity-0', i !== current)
      })
      dots.forEach((dot, i) => {
        const active = i === current
        dot.classList.toggle('w-6', active)
        dot.classList.toggle('bg-white', active)
        dot.classList.toggle('w-2', !active)
        dot.classList.toggle('bg-white/60', !active)
        dot.setAttribute('aria-current', active ? 'true' : 'false')
      })
    }

    const start = () => {
      stop()
      timer = setInterval(() => show(current + 1), 5000)
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        show(i)
        start()
      })
    })

    carousel.addEventListener('mouseenter', stop)
    carousel.addEventListener('mouseleave', start)

    start()
  })()
</script>